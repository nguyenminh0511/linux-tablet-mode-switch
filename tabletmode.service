[Unit]
Description=Virtual tablet mode switch (GPD Pocket 4)

[Service]
Type=simple
ExecStart=/usr/local/bin/tabletmode daemon
Restart=on-failure
RuntimeDirectory=tabletmode
RuntimeDirectoryMode=0755

# Hardening: only needs to write /dev/uinput and create a socket in /run/tabletmode
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
Environment=TABLETMODE_LOG_DIR=@LOG_DIR@
ReadWritePaths=@LOG_DIR@
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
